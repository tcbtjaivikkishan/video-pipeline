{
  "name": "video-pipeline",
  "version": "1.0.0",
  "description": "Automated pipeline to download videos from Zoho WorkDrive and upload to Cloudflare R2",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node --transpile-only src/index.ts",
    "start:prod": "node dist/index.js",
    "process-one": "ts-node --transpile-only src/index.ts --limit 1",
    "watch": "ts-node --transpile-only src/index.ts --watch",
    "test-connection": "ts-node --transpile-only src/index.ts --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
